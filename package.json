{
  "name": "pi-jeev",
  "version": "0.2.0",
  "private": true,
  "description": "A bounded TypeSafe Jev decision tool for Pi",
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings",
    "test": "node --test --test-concurrency=1 ./jev.test.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "eval:live": "node ./eval/live.mjs",
    "eval:agent": "node ./eval/agent-behavior.mjs"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@oxlint/plugins": "1.83.0",
    "@types/node": "22.19.19",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "typebox": "1.3.7",
    "typescript": "7.0.2"
  }
}
